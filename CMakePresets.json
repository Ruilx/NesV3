{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "qt6-mingw-debug",
      "displayName": "Qt 6.11.2 MinGW Debug",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build-qt6",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTS": "ON",
        "CMAKE_PREFIX_PATH": "D:/Qt/6.11.2/mingw_64",
        "CMAKE_C_COMPILER": "D:/Qt/Tools/mingw1310_64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "D:/Qt/Tools/mingw1310_64/bin/g++.exe"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "qt6-mingw-debug",
      "configurePreset": "qt6-mingw-debug",
      "configuration": "Debug",
      "jobs": 4
    }
  ]
}
